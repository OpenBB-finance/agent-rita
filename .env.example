# ── LLM providers ──────────────────────────────────────────────
# Set at least ONE of these (or use Ollama below). A blank key just
# disables that provider; the agent won't start with none configured.
OPENAI_API_KEY=
OPENROUTER_API_KEY=          # Claude, Gemini, DeepSeek, etc. via OpenRouter
GROQ_API_KEY=

# Local models via Ollama.
# IN DOCKER: use host.docker.internal, NOT localhost — inside a container
# "localhost" is the container itself, so it can't reach Ollama on your host.
OLLAMA_BASE_URL=http://localhost:11434/api
# OLLAMA_BASE_URL=http://host.docker.internal:11434/api   # when running in Docker

# ── Model selection ────────────────────────────────────────────
# Effective model =  Workspace settings-wheel picker  >  DEFAULT_MODEL  >  openai:gpt-4o
# The picker (chosen per chat in the Workspace) OVERRIDES DEFAULT_MODEL.
# DEFAULT_MODEL is only the fallback when a request carries no picked model.
# Point it at a provider you keyed above. Editing it needs a server RESTART
# (`--hot` reloads code, not .env).
DEFAULT_MODEL=openai:gpt-4o-mini
# DEFAULT_MODEL=openrouter:google/gemini-3-flash-preview
# DEFAULT_MODEL=ollama:gpt-oss:20b

# ── Companion MCP server (optional) ────────────────────────────
# Only used if you run mcp-server/. The agent runs fine without any of these.
TAKO_API_TOKEN=              # Tako full toolset + account limits (keyless = anonymous free tier)
# TAKO_ENABLED=false         # disables Tako and restores Tavily web_search
# TAKO_MCP_URL=https://mcp.tako.com/mcp   # override upstream endpoint
TAVILY_API_KEY=              # web_search (used only when TAKO_ENABLED=false)
DAYTONA_API_KEY=             # execute_code (Python sandbox)
# OPENAI_API_KEY (above) also powers document RAG embeddings (query_documents)

# Workspace bridge (companion) MCP tools — 18 tools that drive an OpenBB
# Workspace browser tab via /bridge/ws. Off by default; set "true" to enable.
COMPANION_TOOLS_ENABLED=false

# ── Debug ──────────────────────────────────────────────────────
# LIVE_DEBUG_TRACES=1   # clean live trace; 2 = full model I/O JSON (local only)
